<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.MidiControl" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary_light</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant_light</item>
        <item name="colorOnPrimary">@color/colorOnPrimary_light</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant_light</item>
        <item name="colorOnSecondary">@color/colorOnSecondary_light</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/status_bar_color_light</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MidiControl" parent="Base.Theme.MidiControl" />


    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


    <style name="myActionButtonStyle" parent="Widget.AppCompat.ActionButton">
<!--        <item name="android:minWidth">5dp</item>-->
<!--        <item name="android:maxWidth">10dp</item>-->
<!--        <item name="android:width">10dp</item>-->
<!--        <item name="android:paddingStart">30dp</item>-->
<!--        <item name="android:paddingEnd">30dp</item>-->
        <item name="android:drawablePadding">5dp</item>
    </style>

    <style name="ToolbarMinified" parent="Theme.MidiControl">
        <item name="android:textColorSecondary">?attr/colorOnSecondary</item>
        <item name="actionButtonStyle">@style/myActionButtonStyle</item>
        <item name="android:actionButtonStyle">@style/myActionButtonStyle</item>
        <item name="android:paddingEnd">25dp</item>
        <item name="android:paddingStart">25dp</item>
    </style>
</resources>