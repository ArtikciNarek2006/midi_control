<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:allowDividerAbove="true"
        app:allowDividerBelow="true"
        app:key="visualiser_cat"
        app:title="Visualiser configuration">
        <SeekBarPreference
            app:key="visualiser_slide_speed"
            app:title="@string/vis_slide_speed_pref_title" />
    </PreferenceCategory>
    <PreferenceCategory
        app:allowDividerAbove="true"
        app:allowDividerBelow="true"
        app:key="keyboard_cat"
        app:title="Keyboard configuration">
        <SeekBarPreference
            app:key="keyboard_min_pitch"
            app:title="@string/keyboard_min_pitch_pref_title" />
        <SeekBarPreference
            app:key="keyboard_num_notes"
            app:title="@string/keyboard_num_notes_pref_title" />
    </PreferenceCategory>
</PreferenceScreen>